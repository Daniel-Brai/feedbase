#!/usr/bin/env python3


import base64
import sys
from pathlib import Path

from cryptography.hazmat.primitives import serialization

BASE_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(BASE_DIR))

from py_vapid import Vapid

from lib.logger import get_logger
from settings import settings

logger = get_logger("scripts.generate_vapid_keys")


def main() -> int:
    private_key_path = Path(settings.VAPID_PRIVATE_KEY_PATH)
    public_key_path = Path(settings.VAPID_PUBLIC_KEY_PATH)
    credentials_dir = private_key_path.parent
    credentials_dir.mkdir(parents=True, exist_ok=True)

    logger.info(f"Generating VAPID keys in: {credentials_dir}")

    try:
        vapid = Vapid()
        vapid.generate_keys()

        if vapid.public_key is None or vapid.private_key is None:
            logger.error("Failed to generate VAPID keys.")
            return 1

        raw_public = vapid.public_key.public_bytes(
            encoding=serialization.Encoding.X962,
            format=serialization.PublicFormat.UncompressedPoint,
        )
        public_b64 = base64.urlsafe_b64encode(raw_public).rstrip(b"=").decode("utf-8")

        private_pem = vapid.private_key.private_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PrivateFormat.PKCS8,
            encryption_algorithm=serialization.NoEncryption(),
        )

        public_key_path.write_text(public_b64, encoding="utf-8")
        private_key_path.write_bytes(private_pem)

    except ImportError as exc:
        logger.error("Error: py_vapid package is not installed." " Install it via `pip install py-vapid`.", exc_info=True)
        return 1
    except Exception as exc:
        logger.error(f"Error generating or writing VAPID keys: {exc}")
        return 1

    logger.info(f"Public key written to: {public_key_path}")
    logger.info(f"Private key written to: {private_key_path}")
    logger.info("VAPID keys generated successfully.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
