#!/usr/bin/env python

import sys
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(BASE_DIR))

from lib.assets import AssetBuilder

builder = AssetBuilder(
    static_src=BASE_DIR / "assets/src",
    static_dist=BASE_DIR / "assets/dist",
    entry_points=[
        # My App files
        BASE_DIR / "assets/src/css/app.css",
        BASE_DIR / "assets/src/js/app.js",
        # My Custom HTMX extensions
        BASE_DIR / "assets/src/js/extensions/micro-template.0.1.0.js",
        BASE_DIR / "assets/src/js/extensions/pagination.0.1.0.js",
        # My Vendor files
        BASE_DIR / "assets/src/vendor/alpinejs/alpinejs.3.15.9.js",
        BASE_DIR / "assets/src/vendor/htmx/htmx.2.0.8.js",
        BASE_DIR / "assets/src/vendor/htmx/extensions/form-json.2.0.8.js",
        BASE_DIR / "assets/src/vendor/htmx/extensions/loading-states.2.0.8.js",
        BASE_DIR / "assets/src/vendor/htmx/extensions/preload.2.0.8.js",
    ],
    pwa_files=[
        BASE_DIR / "assets/src/js/pwa.js",
        BASE_DIR / "assets/src/pwa/sw.js",
        BASE_DIR / "assets/src/pwa/manifest.json",
    ],
    copy_files=[
        BASE_DIR / "assets/src/images",
        BASE_DIR / "assets/src/vendor/framework7-icons",
    ],
    sourcemap="external",
    bundle=True,
    outbase=BASE_DIR / "assets/src",
)

if __name__ == "__main__":
    builder.build()
